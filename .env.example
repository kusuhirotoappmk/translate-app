# 設定は全部任意です。変えたいときだけこのファイルを .env にコピーして書き換えてください（.env は Git に上がりません）

# 文字起こしモデル（tiny / base / small / medium）。大きいほど正確だが遅い
WHISPER_MODEL=small

# 翻訳モデル（Hugging Face の mlx-community のモデル名）
LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit

# ログインが必要なリールを取得する場合、ログイン済みブラウザ名（chrome / safari など）
YTDLP_COOKIES_FROM_BROWSER=
